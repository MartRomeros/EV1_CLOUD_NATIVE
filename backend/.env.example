# Puerto en el que escucha la API
PORT=3000

# development | production — controla si la conexión a Postgres exige SSL
# (ver src/config/db.js) y si errorHandler expone el stack en las respuestas
NODE_ENV=development

# --- Conexión a Postgres ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_HOST=db
POSTGRES_DB=DB_CLOUD
POSTGRES_PASSWORD=PossGAdmin
POSTGRES_PORT=5432

# search_path de la conexión (esquemas separados por coma)
POSTGRES_SEARCH_PATH=tallerpro360,public

# --- Auth (Entra ID / JWT) ----------------------------------------------------
# true habilita la validación de bearer token; false la deja desactivada
AUTH_REQUIRED=false

AZURE_TENANT_ID=639a8b7f-479a-4d37-9418-bad57badccb1
AZURE_CLIENT_ID=952083c2-4584-4dec-a3d3-5b0077da3e8f
