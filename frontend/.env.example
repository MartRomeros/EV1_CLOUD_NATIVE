# Datos del App Registration en Azure Entra ID (ver README para el paso a paso)
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# En local usa http://localhost:5173 ; en produccion (build para subir por FTP)
# usa https://martin-romero.cl/cloud . Ambas deben estar registradas como
# Redirect URI (tipo SPA) en el App Registration.
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Scope de la API expuesta (Expose an API) que consume el frontend
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# URL base del API Gateway HTTP (ver diagrama de arquitectura)
VITE_API_URL=https://TU-API-ID.execute-api.TU-REGION.amazonaws.com
