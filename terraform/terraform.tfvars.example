# --- AWS Academy (Learner Lab) -------------------------------------------------
#  1. Panel del lab -> "AWS Details" -> "AWS CLI": copia el bloque de credenciales
#     en ~/.aws/credentials bajo el perfil [default]. Se renuevan cada sesión.
#  2. La región del lab suele estar fijada a us-east-1.
#  3. No definas aws_profile salvo que hayas creado un perfil con ese nombre.
#  4. LabRole es el único rol disponible en el lab.
#  5. No se pueden crear claves KMS de cliente: deja el cifrado en AES256.
# -----------------------------------------------------------------------------

aws_region  = "us-east-1"
project     = "ev1-cloud"
environment = "lab"

# --- Red / SSM ---------------------------------------------------------------
# owner_name: tu nombre, exigido por el módulo de la Instancia NAT.
owner_name = "Tu Nombre"

# instance_profile_name: nombre del instance profile de AWS Academy asociado a
# LabRole (verificar en la consola de EC2 -> Instance Profiles; debe incluir
# la policy AmazonSSMManagedInstanceCore para poder usar SSM).
instance_profile_name = "LabInstanceProfile"

# --- Backend ------------------------------------------------------------------
# docker_image: imagen real de backend/ publicada en Docker Hub. Sin valor por
# defecto a propósito: no hay ninguna imagen publicada todavía.
docker_image = "usuario/tallerpro360-backend:latest"

# --- Frontend ------------------------------------------------------------------
# frontend_docker_image: imagen real de frontend/ publicada en Docker Hub.
frontend_docker_image = "usuario/tallerpro360-frontend:latest"

# frontend_domain: debe tener un registro DNS (A) apuntando a la Elastic IP de
# la EC2 Frontend ANTES del primer "terraform apply", para que certbot --nginx
# pueda completar el challenge HTTP-01 en el primer arranque.
frontend_domain = "app.ejemplo.cl"

# certbot_email: email real de contacto para el registro ACME de Let's Encrypt.
certbot_email = "tu-correo@ejemplo.cl"

# --- API Gateway / Entra ID JWT Authorizer ------------------------------------
# entra_tenant_id: Tenant ID de la App Registration de Entra ID (Azure Portal
# -> Microsoft Entra ID -> Overview -> Tenant ID). Ejemplo del tenant actual
# del proyecto (manuelcarvajalapp): "639a8b7f-479a-4d37-9418-bad57badccb1".
entra_tenant_id = "TU-TENANT-ID"

# entra_audience: client ID y/o URI de scope de la App Registration de la API
# (ver frontend/src/environments/environment.ts -> apiScope). Ejemplo:
# ["api://952083c2-4584-4dec-a3d3-5b0077da3e8f"]
entra_audience = ["TU-AUDIENCE"]
